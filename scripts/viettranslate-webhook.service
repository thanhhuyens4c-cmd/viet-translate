[Unit]
Description=VietTranslate GitHub Webhook Receiver Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/157.66.100.101
Environment=WEBHOOK_PORT=9000
Environment=WEBHOOK_HOST=127.0.0.1
Environment=WEBHOOK_SECRET=viettranslate_secure_webhook_key_2026
Environment=DEPLOY_SCRIPT=/usr/local/bin/deploy_viettranslate.sh
Environment=WEBHOOK_LOG=/var/log/viettranslate_webhook.log
ExecStart=/usr/bin/python3 /www/wwwroot/157.66.100.101/scripts/webhook_receiver.py
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
