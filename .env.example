# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# Database (Production — Supabase PostgreSQL)
# DATABASE_URL là biến chính để SQLAlchemy kết nối tới Supabase PostgreSQL.
# Dùng connection string dạng: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres

# Alias được hỗ trợ (dùng khi DATABASE_URL chưa set):
SUPABASE_DB_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
