# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key

# Database (Production — Supabase PostgreSQL)
# DATABASE_URL là biến chính để SQLAlchemy kết nối tới Supabase PostgreSQL.
# Dùng connection string dạng: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres

# Alias được hỗ trợ (dùng khi DATABASE_URL chưa set):
SUPABASE_DB_URL=postgresql+psycopg://postgres:password@db.your-project.supabase.co:5432/postgres

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Thanh toán thật bằng chuyển khoản VietQR (đối soát qua webhook SePay)
# sandbox = nút thanh toán giả để thử; live = chỉ nhận tiền thật, không có nút giả
PAYMENT_MODE=sandbox
BANK_CODE=MBBank
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
# Khóa tự đặt khi tạo webhook trên SePay (kiểu xác thực "API Key"), webhook URL: https://<domain>/api/webhooks/sepay
SEPAY_API_KEY=
CRON_SECRET=

# Mail Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com
